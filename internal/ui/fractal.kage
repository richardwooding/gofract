//kage:unit pixels

// GPU escape-time renderer. Mirrors internal/fractal/kernels.go in float32
// so shallow zooms are instant; the CPU path takes over when float32 runs
// out of precision.
package main

var Center vec2    // plane coordinate at the viewport centre
var Unit float     // plane units per pixel
var Size vec2      // viewport size in pixels
var MaxIter float  // iteration limit
var Type float     // family index: 0 mandelbrot, 1 burningship, 2 tricorn, 3 multibrot3, 4 newton
var JuliaMode float // 1 for Julia mode
var C vec2         // Julia constant
var Offset float   // palette cycling offset
var Density float  // palette steps per iteration

func paletteAt(idx float) vec4 {
	return imageSrc0At(imageSrc0Origin() + vec2(idx+0.5, 0.5))
}

func smooth(i float, m float, power float) float {
	lm := log(m) / 2
	nu := log(lm/log(2.0)) / log(power)
	return i + 1 - nu
}

func escape(z vec2, c vec2) float {
	power := 2.0
	if Type == 3 {
		power = 3.0
	}
	if Type == 1 {
		// Burning ship: flip the imaginary axis so the hull points down.
		z.y = -z.y
		c.y = -c.y
	}
	for i := 0; i < 4096; i++ {
		if float(i) >= MaxIter {
			break
		}
		m := dot(z, z)
		if m > 65536 {
			return smooth(float(i), m, power)
		}
		x2 := z.x * z.x
		y2 := z.y * z.y
		if Type == 0 {
			z = vec2(x2-y2+c.x, 2*z.x*z.y+c.y)
		} else if Type == 1 {
			z = vec2(x2-y2+c.x, abs(2*z.x*z.y)+c.y)
		} else if Type == 2 {
			z = vec2(x2-y2+c.x, -2*z.x*z.y+c.y)
		} else {
			z = vec2(z.x*x2-3*z.x*y2+c.x, 3*x2*z.y-z.y*y2+c.y)
		}
	}
	return -1
}

func newtonValue(i float, d float) float {
	f := log(log(d)/log(1e-12)) / log(2.0)
	return i + 1 - clamp(f, 0, 1)
}

func newton(z vec2) float {
	r1 := vec2(1, 0)
	r2 := vec2(-0.5, 0.8660254)
	r3 := vec2(-0.5, -0.8660254)
	for i := 0; i < 4096; i++ {
		if float(i) >= MaxIter {
			break
		}
		d1 := z - r1
		if dot(d1, d1) < 1e-12 {
			return newtonValue(float(i), dot(d1, d1))
		}
		d2 := z - r2
		if dot(d2, d2) < 1e-12 {
			return newtonValue(float(i), dot(d2, d2)) + 85
		}
		d3 := z - r3
		if dot(d3, d3) < 1e-12 {
			return newtonValue(float(i), dot(d3, d3)) + 170
		}
		// z - (z^3 - 1) / (3 z^2) = (2 z^3 + 1) / (3 z^2)
		zsq := vec2(z.x*z.x-z.y*z.y, 2*z.x*z.y)
		den := 9 * dot(zsq, zsq)
		if den == 0 {
			return -1
		}
		n := vec2(2*(z.x*zsq.x-z.y*zsq.y)+1, 2*(z.x*zsq.y+z.y*zsq.x))
		d := 3 * zsq
		z = vec2(n.x*d.x+n.y*d.y, n.y*d.x-n.x*d.y) / den
	}
	return -1
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	px := dstPos.xy - imageDstOrigin()
	p := vec2(Center.x+(px.x-Size.x/2)*Unit, Center.y-(px.y-Size.y/2)*Unit)
	v := 0.0
	if Type == 4 {
		v = newton(p)
	} else if JuliaMode > 0.5 {
		v = escape(p, C)
	} else {
		v = escape(vec2(0), p)
	}
	if v < 0 {
		return paletteAt(0)
	}
	idx := mod(floor(v*Density)+Offset, 255)
	return paletteAt(idx + 1)
}
